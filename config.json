{
  "sourceLanguage": "zh",
  "targetLanguage": "th",
  "provider": "openai",
  "model": "gpt-4.1",
  "tokenEncoding": "o200k_base",
  "contextWindowTokens": 32768,
  "chunkSizeTokens": 1500,
  "maxOutputTokens": 8192,
  "contextMaxTokens": 3000,
  "previousTextTokens": 500,
  "safetyMarginTokens": 1024,
  "concurrency": 1,
  "translationStyle": "literary",
  "temperature": 0.2,
  "maxRetries": 3,
  "retryBaseMs": 1000,
  "timeoutMs": 120000,
  "minRequestIntervalMs": 500,
  "enableDynamicGlossary": true,
  "enableTerminologyExtraction": true,
  "enableStoryContext": true,
  "enableTranslationMemory": true,
  "enableResume": true,
  "enableQualityCheck": true
}
